# Variables de entorno del frontend (Vite — sólo las prefijadas con VITE_
# llegan al bundle del cliente). Copia este archivo a `.env` y rellena valores.

# CARTO: API key para los tiles del basemap (basemaps.cartocdn.com).
# Requerida por el Mapa Interactivo.
VITE_CARTO_API_KEY=

# Overrides opcionales de la base URL de cada servicio. Sin definir, se usan
# rutas relativas (proxy de Vite → backend Express :3000) o el pipeline :5000.
# VITE_AUTH_API_URL=/api/users
# VITE_MAP_API_URL=/api/map
# VITE_DASHBOARD_API_URL=/api/dashboard
# VITE_CONTROL_API_URL=/api/control
# VITE_PIPELINE_API_URL=http://127.0.0.1:5000
